# Kopieer dit bestand naar .env en vul je eigen waarden in:
#   cp .env.example .env
#
# .env staat in .gitignore en wordt nooit gecommit.

# Anthropic API-key voor de adviesmodule — https://console.anthropic.com/
# Zonder key werkt het dashboard gewoon; alleen 'Genereer advies' is uit.
ANTHROPIC_API_KEY=sk-ant-...

# Flask sessie-sleutel. Genereer een sterke waarde met:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=verander-mij-in-een-lange-willekeurige-string
