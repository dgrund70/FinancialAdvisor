[Unit]
Description=Beleggingsdashboard — koersen ophalen (eenmalig, via timer)

[Service]
Type=oneshot
User=dgrund
WorkingDirectory=/home/dgrund/Investeren-en-beleggen
EnvironmentFile=-/home/dgrund/Investeren-en-beleggen/.env
# "Beleefd" t.o.v. andere processen (zoals Nightwatch): lage CPU-/IO-prioriteit.
Nice=10
CPUWeight=20
IOSchedulingClass=idle
ExecStart=/home/dgrund/Investeren-en-beleggen/.venv/bin/python fetch_prices.py
