[Unit]
Description=Beleggingsdashboard — nachtelijke data (nieuws, fundamentals, historie, benchmark)

[Service]
Type=oneshot
User=dgrund
WorkingDirectory=/home/dgrund/Investeren-en-beleggen
EnvironmentFile=-/home/dgrund/Investeren-en-beleggen/.env
# Zwaardere fetches: extra beleefd én een geheugenplafond, zodat Nightwatch
# nooit verdrongen wordt op een drukke Pi.
Nice=15
CPUWeight=10
IOSchedulingClass=idle
MemoryMax=512M
ExecStart=/home/dgrund/Investeren-en-beleggen/deploy/update_nacht.sh
